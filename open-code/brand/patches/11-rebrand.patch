@@ -59,4 +59,31 @@ type TranslationKey<Key extends Extract<keyof Dictionary, string>> = Key extends
 type Source = { dict: Record<string, string> }
 
+// [cx] 品牌名替换：在唯一翻译出口统一替换用户可见的 OpenCode 文案，同时保护真实服务名、
+// 域名和配置文件名。PRODUCT_NAME 由 desktop 构建配置注入，未配置时保持上游名称。
+const PRODUCT_NAME =
+  typeof import.meta.env.PRODUCT_NAME === "string" && import.meta.env.PRODUCT_NAME.length > 0
+    ? import.meta.env.PRODUCT_NAME
+    : "OpenCode"
+
+const REBRAND_PROTECTED = ["OpenCode Zen", "OpenCode Go", "opencode.ai", "opencode.json"]
+
+function rebrand(text: string): string {
+  if (PRODUCT_NAME === "OpenCode" || (!text.includes("OpenCode") && !text.includes("opencode"))) return text
+  let out = text
+  const holders: string[] = []
+  REBRAND_PROTECTED.forEach((word, i) => {
+    if (!out.includes(word)) return
+    const holder = `CXP${i}`
+    holders[i] = word
+    out = out.split(word).join(holder)
+  })
+  out = out.split("OpenCode").join(PRODUCT_NAME)
+  holders.forEach((word, i) => {
+    if (word === undefined) return
+    out = out.split(`CXP${i}`).join(word)
+  })
+  return out
+}
+
 export function richTemplateParts<Value>(template: string, params: Record<string, Value>) {
   return template
@@ -267,5 +294,5 @@ export const { use: useLanguage, provider: LanguageProvider } = createSimpleCont
 
       // A key outside the dictionary translates to nothing, as it did with the package translator.
-      return template === undefined ? template : resolveTemplate(template, params)
+      return template === undefined ? template : rebrand(resolveTemplate(template, params))
     }
 
@@ -343,5 +370,7 @@ export const { use: useLanguage, provider: LanguageProvider } = createSimpleCont
       if (!current) return
       props.onNativeTranslations(
-        createDesktopNativeBundle(locale(), (key) => current[key] ?? DESKTOP_NATIVE_ENGLISH[key]),
+        // [cx] 原生菜单/对话框文案不走 translator，必须在这里补一次 rebrand()，否则
+        // desktop.menu.app 等字面量里的 "OpenCode" 会绕过品牌替换直达 nativeT()。
+        createDesktopNativeBundle(locale(), (key) => rebrand(current[key] ?? DESKTOP_NATIVE_ENGLISH[key])),
       )
     })
