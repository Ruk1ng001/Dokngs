# 普通翻译和原生菜单的品牌名替换；保留上游未命中字典时返回 undefined 的行为。
diff --git a/packages/app/src/env.d.ts b/packages/app/src/env.d.ts
index b18fe121e715616c875fbf2c29db2926ee7f2c60..1702f0f59e539e4c4d9cea1f22be77dd21152d20 100644
--- a/packages/app/src/env.d.ts
