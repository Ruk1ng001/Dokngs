@@ -8,4 +8,8 @@ interface ImportMetaEnv {
   readonly VITE_SENTRY_ENVIRONMENT?: string
   readonly VITE_SENTRY_RELEASE?: string
+
+  // [cx] 品牌名，经 desktop electron.vite renderer.define 在构建期注入（来自 brand/brand.json
+  // 的 productName）。用于 i18n 文案与桌面菜单的品牌名替换；未注入时代码回退 "OpenCode"。
+  readonly PRODUCT_NAME?: string
 }
 
diff --git a/packages/app/src/runtime/i18n/language.tsx b/packages/app/src/runtime/i18n/language.tsx
index 90e7792a1a072559790c85f0b22648c0be57dc24..ac25cc20de742883f37de15040d7c187d5c47ddc 100644
