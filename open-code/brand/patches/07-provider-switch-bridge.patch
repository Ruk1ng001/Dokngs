# 账户/画布的 Shell、标题栏接线与 provider 切换。09 提供面板，17 提供画布宿主。
diff --git a/packages/app/src/components/cx-account/cx-account-launcher.tsx b/packages/app/src/components/cx-account/cx-account-launcher.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..15400c38d45069884b3a1a6d794b07cbc3b862f1
--- /dev/null
+++ b/packages/app/src/components/cx-account/cx-account-launcher.tsx
@@ -0,0 +1,124 @@
+// [cx] Shell 常驻处理深链、首启引导与命令；按钮由横向标题栏或垂直标签栏直接渲染。
+// 监听器不随标题栏布局重挂载，避免重复首启引导或漏掉 dokng:// 链接。
+
+import { onMount } from "solid-js"
+import { useNavigate } from "@solidjs/router"
+import { Icon } from "@opencode/ui/icon"
+import { IconButton } from "@opencode/ui/icon-button"
+import { Tooltip } from "@opencode/ui/tooltip"
+import { useDialog } from "@opencode/ui/context/dialog"
+import { makeEventListener } from "@solid-primitives/event-listener"
+import { usePlatform } from "@/runtime/platform/platform"
+import { useCommand } from "@/shell/commands/command"
+import { deepLinkEvent, drainPendingDeepLinks } from "./cx-deep-links"
+
+const ACCOUNT_LABEL = "账户"
+
+function useOpenAccount() {
+  const dialog = useDialog()
+
+  return () => {
+    void import("./cx-account-dialog").then((x) => {
+      dialog.show(() => <x.CxDialogAccount />)
+    })
+  }
+}
+
+export function CxAccountLauncher() {
+  const platform = usePlatform()
+  const dialog = useDialog()
+  const command = useCommand()
+  const navigate = useNavigate()
+  const openAccount = useOpenAccount()
+
+  // 非 desktop（web 等）不渲染任何东西：账户面板经 desktop IPC 读写本地 key，web 端无此通道。
+  if (platform.platform !== "desktop") return null
+
+  // dokng:// 一键导入深链：解析出第一条有效链接后弹导入确认框（不静默写入，见 cx-account-import）。
+  const handleDeepLinks = (urls: string[]) => {
+    if (urls.length === 0) return
+    void import("./cx-account-api").then((api) => {
+      for (const url of urls) {
+        const req = api.parseImportDeepLink(url)
+
+        if (!req) continue
+        void import("./cx-account-import").then((x) => {
+          dialog.show(() => <x.CxDialogImport request={req} />)
+        })
+
+        break
+      }
+    })
+  }
+
+  // 常驻命令面板入口，支持键盘操作和侧栏收起时访问。
+  command.register("cx-account", () => [
+    {
+      id: "cx.account.open",
+      title: ACCOUNT_LABEL,
+      // 不设则按 id 前缀归类，cx.* 落不到任何已知前缀、会兜底进 General——显式写出同一结果。
+      section: "general",
+      onSelect: openAccount,
+    },
+    { id: "cx.canvas.open", title: "画布", section: "general", onSelect: () => navigate("/canvas") },
+  ])
+
+  onMount(() => {
+    const handler = (event: Event) => {
+      const detail = (event as CustomEvent<{ urls?: string[] }>).detail
+
+      handleDeepLinks(detail?.urls ?? [])
+    }
+
+    // 先排空启动缓冲（挂载前到达的深链只进了缓冲、事件已派发完），再订阅后续事件，缺一会漏链接。
+    handleDeepLinks(drainPendingDeepLinks(window))
+    makeEventListener(window, deepLinkEvent, handler as EventListener)
+
+    // [cx] FR-3.6: 首启无 key 引导。启动时读本地 key 列表，若为空则自动弹账户面板（AddKeyForm
+    // 以 startOpen 展开，引导即进入新增流程）。仅触发一次：dialog.show 是一次性的，且添加后
+    // keys 非空，本会话内不会重弹。
+    void import("./cx-account-api").then(async (api) => {
+      const state = await api.loadChannelState()
+
+      if (api.resolveKeyList(state).length > 0) return
+      openAccount()
+    })
+  })
+
+  return null
+}
+
+export function CxAccountButtons() {
+  const platform = usePlatform()
+  const navigate = useNavigate()
+  const openAccount = useOpenAccount()
+
+  if (platform.platform !== "desktop") return null
+
+  return (
+    <div class="flex items-center gap-1 shrink-0 [app-region:no-drag]">
+      <Tooltip placement="bottom" value="画布">
+        <IconButton
+          type="button"
+          variant="ghost-muted"
+          size="large"
+          class="shrink-0"
+          icon={<Icon name="palette" />}
+          onClick={() => navigate("/canvas")}
+          aria-label="画布"
+        />
+      </Tooltip>
+      <Tooltip placement="bottom" value={ACCOUNT_LABEL}>
+        <IconButton
+          type="button"
+          variant="ghost-muted"
+          size="large"
+          class="shrink-0"
+          icon={<Icon name="user" />}
+          onClick={openAccount}
+          aria-label={ACCOUNT_LABEL}
+        />
+      </Tooltip>
+    </div>
+  )
+}
diff --git a/packages/app/src/components/cx-account/cx-deep-links.ts b/packages/app/src/components/cx-account/cx-deep-links.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2098e2aab40d8273ea76425ec38ab38f67ca0b54
--- /dev/null
+++ b/packages/app/src/components/cx-account/cx-deep-links.ts
@@ -0,0 +1,35 @@
+// [cx] app 包侧的 deep-link 消费工具（US-013 一键导入深链需要）。
+//
+// 为什么要自带这两个函数：上游 v1 在 app 包里有 pages/layout/deep-links.ts（导出
+// deepLinkEvent / drainPendingDeepLinks），因为 v1 的 layout.tsx 自己要消费 opencode://
+// 的「打开项目」深链。v2 把这套消费逻辑整条移出了 app 包——app 包现在对 deep-link 零引用，
+// 派发方只剩 desktop 的 renderer/startup/deep-links.ts：
+//   window.__OPENCODE__.deepLinks = [...已有, ...新到]   // 启动缓冲（renderer 挂载前到达的）
+//   window.dispatchEvent(new CustomEvent("opencode:deep-link", { detail: { urls } }))
+// 协议名与缓冲字段都仍在，只是 app 侧没有读取者了。故本文件只重建「读取端」，与 desktop
+// 派发端的两个契约（事件名、缓冲字段）对齐，不新造通路、不碰 desktop 侧代码。
+
+/** desktop renderer 派发的 deep-link 事件名（与 renderer/startup/deep-links.ts 一致）。 */
+export const deepLinkEvent = "opencode:deep-link"
+
+type DeepLinkWindow = Window & {
+  __OPENCODE__?: { deepLinks?: string[] }
+}
+
+/**
+ * 取走并清空启动缓冲里的深链。
+ *
+ * 必要性：主进程可能在 renderer 挂载（本组件 onMount）之前就收到了深链（冷启动点链接、
+ * second-instance），那批 URL 只进了 window.__OPENCODE__.deepLinks 缓冲，事件已经派发完了。
+ * 故挂载时必须先排空缓冲，再订阅后续事件，两者缺一就会漏链接。
+ */
+export function drainPendingDeepLinks(target: Window): string[] {
+  const store = (target as DeepLinkWindow).__OPENCODE__
+  if (!store) return []
+  const urls = store.deepLinks
+
+  if (!urls?.length) return []
+  store.deepLinks = []
+
+  return urls
+}
diff --git a/packages/app/src/components/cx-account/cx-provider-switch-bridge.tsx b/packages/app/src/components/cx-account/cx-provider-switch-bridge.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..15f39b766a8d185821d5be4770b98a55cb07e56c
--- /dev/null
+++ b/packages/app/src/components/cx-account/cx-provider-switch-bridge.tsx
@@ -0,0 +1,84 @@
+// [cx] 桥接组件：账户面板（CxDialogAccount，经 DialogProvider 挂在 opencode 组件树之外、
+// 够不到 useLocal()）通过 window CustomEvent `cx:select-provider` 请求切换到某个 key 对应的
+// provider/model；本组件挂在 LocalProvider 作用域内，收到事件后调用与原生 model 选择器同一个
+// 入口 useLocal().model.set(...)，把当前会话切到该 provider —— 纯请求级、零重启，效果同原生
+// 「闪一下」。detail: { providerID: string; modelID: string }
+//
+// 多 provider 改造总述（配合 03 的多 provider 注入 + 04 的 channelProviderId）：每个本地 key
+// 被注入成一个独立 opencode provider（providerID = `newapi-<id前8位>`），内核启动时同时握有
+// 全部 key 的 provider。在已注入的 key 之间切换是纯请求级（本桥的 model.set），零重启；只有
+// 新增/删除 key 改变了 provider 集合，才需重启一次让新 provider 注册进内核。
+//
+// [cx] 上游 v2 重构：v1 本组件内联在 pages/directory-layout.tsx 里（DirectoryDataProvider）。
+// v2 把该文件换成了 shell/routes/session-ui-provider.tsx（SessionUIProvider），LocalProvider
+// 也从 @/context/local 迁到 @/providers/models/selection。这里独立成文件，对上游 v2 的侵入
+// 压到「一行 import + 一行挂载」。
+
+import { onCleanup } from "solid-js"
+import { useLocal } from "@/providers/models/selection"
+
+export const cxSelectProviderEvent = "cx:select-provider"
+
+// [cx] 上游 v2 在 model.set 里新增了 validModel 守卫：provider 必须已在
+// providers.all() 且在 connected() 里、且该 provider 下确有此 modelID，否则 set 静默 return。
+// v1 无此守卫（直写），所以 v1 发完事件即生效。v2 下「刚新增一个 key 就切过去」会撞上时序：
+// 写 config → 内核重建 provider → renderer 经 server 事件重新同步 provider/model 列表，
+// 这几步完成前守卫不满足，请求会被静默丢掉。故这里做一次有界重试（轮询 model.list() 直到
+// 目标 provider/model 出现），等到即切、等不到即放弃，不抛错也不阻塞 UI。
+const RETRY_INTERVAL_MS = 300
+const RETRY_TIMEOUT_MS = 10_000
+
+export function CxProviderSwitchBridge() {
+  const local = useLocal()
+  // 只保留最后一次请求的重试计时器：用户连点两个 key 时，前一次重试必须让位，
+  // 否则两个定时器会竞争、最终切到先满足守卫的那个（而非用户最后点的那个）。
+  let timer: ReturnType<typeof setTimeout> | undefined
+
+  const stop = () => {
+    if (timer === undefined) return
+    clearTimeout(timer)
+    timer = undefined
+  }
+
+  const switchTo = (providerID: string, modelID: string) => {
+    const deadline = Date.now() + RETRY_TIMEOUT_MS
+
+    const attempt = () => {
+      timer = undefined
+      // 与 validModel 同一判据（provider 下确有该 model）；connected 由服务端 provider 列表
+      // 决定，注入的 newapi-* 一旦注册进内核就同时进 all 与 connected，故查 list 足够。
+      const ready = local.model.list().some((item) => item.provider.id === providerID && item.id === modelID)
+
+      if (ready) {
+        local.model.set({ providerID, modelID }, { recent: true })
+
+        return
+      }
+
+      if (Date.now() >= deadline) return
+      timer = setTimeout(attempt, RETRY_INTERVAL_MS)
+    }
+
+    attempt()
+  }
+
+  const handler = (event: Event) => {
+    const detail = (event as CustomEvent).detail as { providerID?: unknown; modelID?: unknown } | undefined
+
+    if (!detail) return
+    const providerID = typeof detail.providerID === "string" ? detail.providerID : undefined
+    const modelID = typeof detail.modelID === "string" ? detail.modelID : undefined
+
+    if (!providerID || !modelID) return
+    stop()
+    switchTo(providerID, modelID)
+  }
+
+  window.addEventListener(cxSelectProviderEvent, handler)
+  onCleanup(() => {
+    stop()
+    window.removeEventListener(cxSelectProviderEvent, handler)
+  })
+
+  return null
+}
