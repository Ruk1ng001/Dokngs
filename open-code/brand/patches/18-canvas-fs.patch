+import { Effect } from "effect"
+import { CanvasRpcs } from "../../shared/ipc-rpc/canvas"
+import {
+  canvasFileWrite,
+  canvasFileRead,
+  canvasFileDelete,
+  canvasFileList,
+  canvasStateRead,
+  canvasStateWrite,
+} from "../store-canvas-files"
+
+// The storage layer owns key validation, size limits and atomic writes; never log payloads.
+export const canvasHandlers = CanvasRpcs.toLayer(
+  Effect.sync(() =>
+    CanvasRpcs.of({
+      CanvasFileWrite: ({ key, base64, mime }) => Effect.promise(() => canvasFileWrite(key, base64, mime)),
+      CanvasFileRead: ({ key }) => Effect.promise(() => canvasFileRead(key)),
+      CanvasFileDelete: ({ keys }) => Effect.promise(() => canvasFileDelete([...keys])),
+      CanvasFileList: () => Effect.promise(canvasFileList),
+      CanvasStateRead: () => Effect.promise(canvasStateRead),
+      CanvasStateWrite: ({ json }) => Effect.promise(() => canvasStateWrite(json)),
+    }),
+  ),
+)
