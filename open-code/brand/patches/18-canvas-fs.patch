index 0000000000..3faa409e12
--- /dev/null
+++ b/packages/desktop/src/main/store-canvas-files.ts
@@ -0,0 +1,249 @@
+// [dokng] 画布数据落盘（替代 IndexedDB）。
+//
+// 背景：画布（infinite-canvas，跑在 oc://renderer 的 iframe 里）原先把图片/视频/音频
+// 二进制存 IndexedDB，节点元数据里只留 URL.createObjectURL() 产生的 blob: URL —— 那是
+// 会话级的，重启即失效，靠启动时 hydrate 从 IndexedDB 重建。两个后果：
+//   1. IndexedDB 未申请 navigator.storage.persist()，属 best-effort 存储，可被浏览器回收；
+//   2. 画布 JSON 的 persist 有 400ms debounce 且无 beforeunload 兜底，而主进程走 app.exit(0)
+//      硬退出，pending 写直接丢 —— 节点没了，磁盘上的图片就成了无人引用的孤儿。
+// 改为落到 userData 下的固定路径，字节和元数据都在磁盘上，不受存储回收与退出时序影响。
+//
+// 磁盘布局（userData = app.getPath("userData") = appData/<appId>）：
+//   <userData>/canvas-files/<sanitized storageKey>.<ext>   媒体原始字节
+//   <userData>/canvas-state.json                           画布项目 / 节点 / 连线
+//
+// 安全边界（本文件是唯一的路径解析处，全部入参都来自画布 iframe，视为不可信）：
+//   - storageKey 必须匹配 STORAGE_KEY_PATTERN（`<kind>:<id>`，id 仅 [A-Za-z0-9_-]），
+//     再经 sanitize 把 ":" 换成 "__"；任何越界字符直接拒绝，不做"尽力清洗"。
+//   - 解析后再用 relative() 复核落在 filesDir 内，双重闸门（模式匹配 + 路径复核），
+//     与 windows.ts 里 oc:// 协议 handler 的做法一致。
+//   - 只允许固定扩展名集合，避免写出 .exe/.lnk 等可执行/可劫持后缀。
+//   - 一律不打印 key 与内容，错误只回 false / null，不外泄绝对路径。
+import { app } from "electron"
+import { mkdir, readdir, readFile, rename, unlink, writeFile } from "node:fs/promises"
+import { isAbsolute, join, relative } from "node:path"
+import { randomUUID } from "node:crypto"
+
+// 画布侧 storageKey 的形态：image:xxx / video:xxx / audio:xxx / file:xxx /
+// video-reference:xxx / audio-reference:xxx（与 app-sync.ts 的 storageKeyPattern 同源）。
+const KINDS = ["image", "video", "audio", "file", "video-reference", "audio-reference"] as const
+const STORAGE_KEY_PATTERN = new RegExp(`^(${KINDS.join("|")}):[A-Za-z0-9_-]{1,128}$`)
+
+// 白名单扩展名：画布只产出这些媒体类型；未知 mime 落 .bin（惰性，不可执行）。
+const ALLOWED_EXTENSIONS = new Set([
+  "png",
+  "jpg",
+  "jpeg",
+  "webp",
+  "gif",
+  "svg",
+  "mp4",
+  "webm",
+  "mov",
+  "mp3",
+  "wav",
+  "ogg",
+  "opus",
+  "aac",
+  "flac",
+  "bin",
+])
+
+// mime → 扩展名。画布侧只有 Blob，没有文件名，故由 blob.type 推扩展名：
+// 扩展名决定 oc:// 协议返回的 Content-Type，<video>/<audio> 依赖它才能正确解码。
+const MIME_EXTENSIONS: Record<string, string> = {
+  "image/png": "png",
+  "image/jpeg": "jpg",
+  "image/jpg": "jpg",
+  "image/webp": "webp",
+  "image/gif": "gif",
+  "image/svg+xml": "svg",
+  "video/mp4": "mp4",
+  "video/webm": "webm",
+  "video/quicktime": "mov",
+  "audio/mpeg": "mp3",
+  "audio/mp3": "mp3",
+  "audio/wav": "wav",
+  "audio/x-wav": "wav",
+  "audio/ogg": "ogg",
+  "audio/opus": "opus",
+  "audio/aac": "aac",
+  "audio/flac": "flac",
+}
+
+// 单文件上限 256MB：画布单个视频不应超过这个量级，防画布侧异常把主进程内存打爆。
+const MAX_FILE_BYTES = 256 * 1024 * 1024
+
+// 画布 JSON 上限 64MB：纯元数据（不含二进制），正常量级在 KB~MB。
+const MAX_STATE_BYTES = 64 * 1024 * 1024
+
+const FILES_DIR = "canvas-files"
+const STATE_FILE = "canvas-state.json"
+
+function filesDir() {
+  return join(app.getPath("userData"), FILES_DIR)
+}
+
+function stateFile() {
+  return join(app.getPath("userData"), STATE_FILE)
+}
+
+// storageKey → 文件名主体。":" 在 Windows 上是非法文件名字符（且是 NTFS ADS 分隔符），换成 "__"。
+// 只替换 kind 与 id 之间那一个 ":"（模式已保证全串仅此一个）。
+function sanitizeKey(storageKey: string) {
+  return storageKey.replace(":", "__")
+}
+
+// 文件名主体 → storageKey。id 自身允许含 "__"，故只还原第一个 "__"，
+// 且必须落在已知 kind 上；否则视为不是我们写的文件，丢弃。
+function unsanitizeKey(base: string) {
+  for (const kind of KINDS) {
+    const prefix = `${kind}__`
+    if (base.startsWith(prefix)) return `${kind}:${base.slice(prefix.length)}`
+  }
+  return null
+}
+
+function extensionFromMime(mime: string | undefined) {
+  const ext = MIME_EXTENSIONS[(mime || "").toLowerCase().split(";")[0].trim()]
+  return ext && ALLOWED_EXTENSIONS.has(ext) ? ext : "bin"
+}
+
+// 校验并拼出绝对路径。非法入参返回 null（调用方一律当失败处理，不回退、不猜测）。
+function filePathFor(storageKey: string, extension: string) {
+  if (!STORAGE_KEY_PATTERN.test(storageKey)) return null
+  if (!ALLOWED_EXTENSIONS.has(extension)) return null
+  const dir = filesDir()
+  const file = join(dir, `${sanitizeKey(storageKey)}.${extension}`)
+  // 双重闸门：模式匹配已排除 ".." 与路径分隔符，这里再复核结果确实在 dir 内。
+  const rel = relative(dir, file)
+  if (!rel || rel.startsWith("..") || isAbsolute(rel)) return null
+  return file
+}
+
+// 同一个 key 可能以不同扩展名落盘（mime 变化 / 历史迁移），读取时按主体名前缀找现存的那个。
+async function findExistingFile(storageKey: string) {
+  if (!STORAGE_KEY_PATTERN.test(storageKey)) return null
+  const dir = filesDir()
+  const prefix = `${sanitizeKey(storageKey)}.`
+  const entries = await readdir(dir).catch(() => [] as string[])
+  const match = entries.find((entry) => entry.startsWith(prefix) && !entry.endsWith(".tmp"))
+  if (!match) return null
+  return filePathFor(storageKey, match.slice(prefix.length))
+}
+
+// 原子写：先写临时文件再 rename。rename 在同一文件系统内是原子的，
+// 避免进程被杀 / 断电时留下半截文件（重启后读到截断的图片或坏 JSON）。
+async function writeAtomic(file: string, data: Buffer) {
+  const tmp = `${file}.${randomUUID()}.tmp`
+  await writeFile(tmp, data)
+  try {
+    await rename(tmp, file)
+  } catch (error) {
+    await unlink(tmp).catch(() => {})
+    throw error
+  }
+}
+
+// 写入媒体字节。mime 用于决定扩展名（进而决定 oc:// 返回的 Content-Type）。
+// 成功返回 true；key 非法 / 超限 / IO 失败返回 false。
+export async function canvasFileWrite(storageKey: string, base64: string, mime?: string) {
+  const file = filePathFor(storageKey, extensionFromMime(mime))
+  if (!file) return false
+  let bytes: Buffer
+  try {
+    bytes = Buffer.from(base64, "base64")
+  } catch {
+    return false
+  }
+  if (bytes.byteLength === 0 || bytes.byteLength > MAX_FILE_BYTES) return false
+  try {
+    await mkdir(filesDir(), { recursive: true })
+    // 同 key 换扩展名时清掉旧的，否则 findExistingFile 可能命中过期字节。
+    const stale = await findExistingFile(storageKey)
+    await writeAtomic(file, bytes)
+    if (stale && stale !== file) await unlink(stale).catch(() => {})
+    return true
+  } catch {
+    return false
+  }
+}
+
+// 读回媒体字节（base64）。不存在或读失败返回 null。
+// 正常渲染路径不走这里 —— 画布用 oc://renderer/__canvas-file/<key> 直接让浏览器加载；
+// 这个接口留给导出 / WebDAV 同步等需要拿到字节本身的场景。
+export async function canvasFileRead(storageKey: string): Promise<string | null> {
+  const file = await findExistingFile(storageKey)
+  if (!file) return null
+  const data = await readFile(file).catch(() => null)
+  return data ? data.toString("base64") : null
+}
+
+// 删除指定 key 的文件，返回实际删除数量。
+export async function canvasFileDelete(storageKeys: string[]) {
+  let removed = 0
+  for (const storageKey of storageKeys) {
+    if (typeof storageKey !== "string") continue
+    const file = await findExistingFile(storageKey)
+    if (!file) continue
+    const ok = await unlink(file).then(
+      () => true,
+      () => false,
+    )
+    if (ok) removed += 1
+  }
+  return removed
+}
+
+// 列出磁盘上现存的 storageKey。画布侧用它做孤儿清理与"是否已迁移"判定。
+export async function canvasFileList() {
+  const entries = await readdir(filesDir()).catch(() => [] as string[])
+  const keys: string[] = []
+  for (const entry of entries) {
+    if (entry.endsWith(".tmp")) continue
+    const dot = entry.lastIndexOf(".")
+    if (dot <= 0) continue
+    const key = unsanitizeKey(entry.slice(0, dot))
+    if (key && STORAGE_KEY_PATTERN.test(key)) keys.push(key)
+  }
+  return keys
+}
+
+export async function canvasStateRead(): Promise<string | null> {
+  const data = await readFile(stateFile(), "utf8").catch(() => null)
+  return data ?? null
+}
+
+export async function canvasStateWrite(json: string) {
+  if (typeof json !== "string") return false
+  if (Buffer.byteLength(json, "utf8") > MAX_STATE_BYTES) return false
+  try {
+    await writeAtomic(stateFile(), Buffer.from(json, "utf8"))
+    return true
+  } catch {
+    return false
+  }
+}
+
+// 供 windows.ts 的 oc:// 协议 handler 解析 /__canvas-file/<tail>。
+// tail 有两种形态，都要支持：
+//   - 带扩展名（画布已知扩展名时直接拼，快路径，无目录扫描）：image__abc123.png
+//   - 只有 key（迁移后仅凭 canvasFileList 得到 key）：image:abc123 或 image__abc123
+// 返回 null 表示拒绝，handler 回 404。
+export async function resolveCanvasFilePath(tail: string): Promise<string | null> {
+  if (!tail || tail.length > 256) return null
+  // 快路径：<sanitized key>.<ext>
+  const dot = tail.lastIndexOf(".")
+  if (dot > 0) {
+    const key = unsanitizeKey(tail.slice(0, dot))
+    const ext = tail.slice(dot + 1).toLowerCase()
+    if (key) {
+      const file = filePathFor(key, ext)
+      if (file) return file
+    }
+  }
+  // 慢路径：只给了 key，扫目录定扩展名。
+  const key = tail.includes(":") ? tail : unsanitizeKey(tail)
+  if (!key) return null
+  return findExistingFile(key)
+}
