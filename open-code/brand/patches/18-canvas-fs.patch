+++ b/packages/desktop/src/shared/ipc-rpc/canvas.ts
@@ -0,0 +1,31 @@
+// [dokng] Typed transport for the existing canvas media and state storage.
+import { Schema } from "effect"
+import { Rpc, RpcGroup } from "effect/rpc"
+
+export const CanvasFileWrite = Rpc.make("CanvasFileWrite", {
+  payload: { key: Schema.String, base64: Schema.String, mime: Schema.optionalKey(Schema.String) },
+  success: Schema.Boolean,
+})
+export const CanvasFileRead = Rpc.make("CanvasFileRead", {
+  payload: { key: Schema.String },
+  success: Schema.NullOr(Schema.String),
+})
+export const CanvasFileDelete = Rpc.make("CanvasFileDelete", {
+  payload: { keys: Schema.Array(Schema.String) },
+  success: Schema.Number,
+})
+export const CanvasFileList = Rpc.make("CanvasFileList", { success: Schema.Array(Schema.String) })
+export const CanvasStateRead = Rpc.make("CanvasStateRead", { success: Schema.NullOr(Schema.String) })
+export const CanvasStateWrite = Rpc.make("CanvasStateWrite", {
+  payload: { json: Schema.String },
+  success: Schema.Boolean,
+})
+
+export const CanvasRpcs = RpcGroup.make(
+  CanvasFileWrite,
+  CanvasFileRead,
+  CanvasFileDelete,
+  CanvasFileList,
+  CanvasStateRead,
+  CanvasStateWrite,
+)
