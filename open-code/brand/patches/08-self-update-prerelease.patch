# gui-plugins 更新器：允许品牌版本后缀，安装失败时提供下载入口。
diff --git a/packages/gui-plugins/src/updater/platform.ts b/packages/gui-plugins/src/updater/platform.ts
index e562c5a0db4c286793b458f170e918681d1bb913..63ce525cbac5b55a2c008dfb7464bf6b6860720c 100644
--- a/packages/gui-plugins/src/updater/platform.ts
+++ b/packages/gui-plugins/src/updater/platform.ts
@@ -1,5 +1,5 @@
 import { execFile } from "node:child_process"
 import { promisify } from "node:util"
-import { app, autoUpdater } from "electron"
+import { app, autoUpdater, dialog, shell } from "electron"
 import pkg from "electron-updater"
 import { Effect } from "effect"
@@ -11,4 +11,6 @@ const execFileAsync = promisify(execFile)
 
 const restartTimeout = 10_000
+// [dokng] 自动安装失败时提供覆盖安装入口，保留用户数据。
+const downloadPage = "https://dokng.com/"
 
 const unpackTimeout = 120_000
@@ -25,5 +27,7 @@ export const make = Effect.fn("Updater.platform")(function* (channel: string) {
   updateClient.channel = "latest"
   updateClient.requestHeaders = { "User-Agent": userAgent }
-  updateClient.allowPrerelease = false
+  // [dokng] dokng 版本号带 -dokng.N prerelease 后缀，GitHubProvider 需要放行该后缀。
+  // GenericProvider 当前按 latest*.yml 的 version 比对，此设置对其无害。
+  updateClient.allowPrerelease = true
   updateClient.allowDowngrade = true
   updateClient.autoDownload = false
@@ -158,3 +162,26 @@ const installAndRestart = Effect.callback<void, Error>((resume) => {
       ),
   }),
+  // [dokng] ad-hoc 签名包等安装失败时，菜单和界面两条入口都能得到下载指引。
+  Effect.tapError(notifyInstallFailure),
 )
+
+function notifyInstallFailure(error: Error) {
+  return Effect.gen(function* () {
+    const result = yield* Effect.promise(() =>
+      dialog.showMessageBox({
+        type: "warning",
+        buttons: ["前往下载页", "稍后"],
+        defaultId: 0,
+        cancelId: 1,
+        message: "自动更新安装失败",
+        detail:
+          "新版本已下载完成，但无法自动安装。请前往官网下载最新版本并覆盖安装，本地数据（模型 key、画布文件）不会丢失。\n\n详细错误见调试日志。",
+      }),
+    )
+
+    if (result.response === 0) yield* Effect.tryPromise(() => shell.openExternal(downloadPage))
+  }).pipe(
+    // 指引失败仍保留原始安装错误。
+    Effect.catchCause((cause) => Effect.logError("could not show the install failure guidance", { cause, error })),
+  )
+}
