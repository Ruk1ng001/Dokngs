+const DOWNLOAD_PAGE_URL = "https://dokng.com/"
+
+// [dokng] macOS ad-hoc 签名包的自更新在架构上必然失败，且失败是异步的：Squirrel.Mac 安装前
+// 会用正在运行 app 的 designated requirement 校验新包，ad-hoc 签名的 cdhash 必然随版本变化，
+// 所以校验永远不会通过。安装失败由 electron-updater 异步发出 error 事件，不会从 quitAndInstall
+// 同步抛出；这里记录一次失败并引导用户手动覆盖安装，避免 UI 回到 ready 后无限重复点击。
+let installFailure: string | undefined
+let installAttempted = false
+
+async function notifyInstallFailure() {
+  const result = await dialog.showMessageBox({
+    type: "warning",
+    buttons: ["前往下载页", "稍后"],
+    defaultId: 0,
+    cancelId: 1,
+    message: "自动更新安装失败",
+    detail:
+      "新版本已下载完成，但无法自动安装。请前往官网下载最新版本并覆盖安装，本地数据（模型 key、画布文件）不会丢失。\n\n详细错误见调试日志。",
+  })
+  if (result.response === 0) openExternalURL(DOWNLOAD_PAGE_URL)
+}
