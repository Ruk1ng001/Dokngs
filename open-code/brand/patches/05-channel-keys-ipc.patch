diff --git a/packages/desktop/src/shared/ipc-rpc/channel-keys.ts b/packages/desktop/src/shared/ipc-rpc/channel-keys.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d7b823b0ca8dc00a8f8a37b697b3f2ccbfeb2abe
--- /dev/null
+++ b/packages/desktop/src/shared/ipc-rpc/channel-keys.ts
@@ -0,0 +1,90 @@
+// [cx] US-009: 本地 key 管理的 IPC 契约 —— renderer 侧账户面板增删改 key / 切换激活项，
+// 全部走主进程数据层（main/store-channel-keys.ts）。
+//
+// [cx] 上游 v2 重构：v1 这组通道是 ipcMain.handle("channel-keys-*") + preload contextBridge
+// 暴露 window.api.channelKeys*。v2 把整个 IPC 层换成 Effect 的 RpcServer over MessagePort
+// （契约在 shared/ipc-rpc/*，handler 在 main/ipc-handlers/*，renderer 调 invoke()），
+// window.api 已不存在，故本组通道按 v2 范式重写为 RPC 契约。
+//
+// 返回值：统一回**类型化的 ChannelKeysState 对象**（而非 v1 的 JSON 字符串）。v1 回字符串只是
+// 为了迁就通用 store-get「非字符串就 JSON.stringify」的约定；v2 的 RPC 是 schema 驱动的
+// （参见同目录 storage.ts 的 StorageItems 直接回 Struct），renderer 拿到的就是对象，
+// 省掉一次 JSON.parse 与随之而来的类型断言。
+//
+// 安全底线（同 main/store-channel-keys.ts）：key 明文仅在本机主进程与渲染进程之间传递
+// （渲染侧 key 管理 UI 需要回显/编辑），绝不上传、绝不写日志。handler 侧不打印任何入参。
+
+import { Schema } from "effect"
+import { Rpc, RpcGroup } from "effect/rpc"
+
+// 单个渠道 key 条目。与 main/store-channel-keys.ts 的 ChannelKey 同构——那边是被同步读写的
+// 纯数据层（不引 Schema），此处是过线的编解码契约；两者结构不一致时 handler 处 typecheck 即报错。
+export const ChannelKey = Schema.Struct({
+  id: Schema.String,
+  label: Schema.String,
+  key: Schema.String,
+  baseURL: Schema.String,
+  // 该 key 的可用模型 id 列表（切换/新增时主进程拉 /v1/models 落盘的缓存）。老数据无此字段。
+  models: Schema.optionalKey(Schema.Array(Schema.String)),
+})
+
+export type ChannelKey = typeof ChannelKey.Type
+
+// 完整状态。activeKeyId 指向当前激活项；无激活项时为 null。
+export const ChannelKeysState = Schema.Struct({
+  keys: Schema.Array(ChannelKey),
+  activeKeyId: Schema.NullOr(Schema.String),
+})
+
+export type ChannelKeysState = typeof ChannelKeysState.Type
+
+// 读取整份状态（面板打开 / 每次写操作后刷新 UI）。
+export const ChannelKeysList = Rpc.make("ChannelKeysList", { success: ChannelKeysState })
+
+// 新增一个 key。第一个 key 自动成为激活项（见数据层 addChannelKey）。
+export const ChannelKeysAdd = Rpc.make("ChannelKeysAdd", {
+  payload: { label: Schema.String, key: Schema.String, baseURL: Schema.String },
+  success: ChannelKeysState,
+})
+
+// 删除指定 key。删的是激活项时，激活项回退到剩余列表首个。
+export const ChannelKeysRemove = Rpc.make("ChannelKeysRemove", {
+  payload: { id: Schema.String },
+  success: ChannelKeysState,
+})
+
+// 改 label。id 不存在时静默忽略。
+export const ChannelKeysUpdateLabel = Rpc.make("ChannelKeysUpdateLabel", {
+  payload: { id: Schema.String, label: Schema.String },
+  success: ChannelKeysState,
+})
+
+// 设为激活项。id 不在列表中时静默忽略。
+export const ChannelKeysSetActive = Rpc.make("ChannelKeysSetActive", {
+  payload: { id: Schema.String },
+  success: ChannelKeysState,
+})
+
+// 写入某 key 的可用模型列表缓存。
+export const ChannelKeysSetModels = Rpc.make("ChannelKeysSetModels", {
+  payload: { id: Schema.String, models: Schema.Array(Schema.String) },
+  success: ChannelKeysState,
+})
+
+// [cx] 内置渠道热重载（带拉模型）：新增 key 后调此——主进程拉该 key 的 /v1/models（无 CORS）
+// 落盘，再重写 OPENCODE_CONFIG 文件，内核监听到变更即把该 key 作为 provider 上线。不重启进程。
+export const ChannelConfigRefreshKey = Rpc.make("ChannelConfigRefreshKey", { payload: { id: Schema.String } })
+
+// [cx] 内置渠道热重载（不拉模型）：删除 key 后调此——重写文件，provider 随之消失。
+export const ChannelConfigReload = Rpc.make("ChannelConfigReload")
+
+export const ChannelKeysRpcs = RpcGroup.make(
+  ChannelKeysList,
+  ChannelKeysAdd,
+  ChannelKeysRemove,
+  ChannelKeysUpdateLabel,
+  ChannelKeysSetActive,
+  ChannelKeysSetModels,
+  ChannelConfigRefreshKey,
+  ChannelConfigReload,
+)
