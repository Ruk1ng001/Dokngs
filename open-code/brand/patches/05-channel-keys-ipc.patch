# 05-channel-keys-ipc —— key 管理 IPC 通道（US-009）
#
# 职责：把 04 的本地 key 数据层（store-channel-keys）经专用 IPC 暴露给 renderer，
# 支撑「增删改 key + 手动切换激活 key」的账户面板 UI（01 补丁 balance-panel）。
#   1. main/ipc.ts —— import 04 的 store-channel-keys，新增 channel-keys-* handler：
#      channel-keys-list / -add / -remove / -update-label / -set-active / -set-models。
#      每个 handler 走主进程数据层增删改后，返回 JSON.stringify 的最新 ChannelKeysState
#      字符串（与 store-get 对非字符串 JSON.stringify 的约定一致），renderer 解析回对象刷新 UI。
#   2. preload/types.ts —— ElectronAPI 增补 channelKeys* 方法签名。
#   3. preload/index.ts —— 经 ipcRenderer.invoke 桥接上述 IPC。
#
# 为什么不复用通用 store-set：通用 store-set 会把整个 channelKeys 对象存成 JSON 字符串，
# 破坏主进程侧 readChannelKeysState 的「对象读取」（04 用 getStore().get 期望对象）。故为
# key 管理开专用 IPC，写入统一走 04 的数据层，保证主/渲染两侧对同一份对象态的读写一致。
#
# 切换激活 key 的「重启内核」：复用既有 window.api.relaunch（stopSidecars → app.relaunch，
# US-002 结论：内核 config 启动期一次性注入，换 key 必须重启 sidecar 才生效），不新增重启 IPC。
#
# 安全底线：key 管理 handler 一律不打印任何入参（尤其 sk- 明文），仅透传给数据层。
# 依赖：引用 04 的 store-channel-keys（按 NN 序 04→05 应用，git apply 只做文本操作不校验 import，
#      typecheck 在全部补丁应用后才跑）。独立于 01/02/03 的文件。
# 应用（在 opencode/ 内，基线为 brand/BASE_SHA，按 01→02→03→04→05 顺序）：
#   git -C opencode apply --3way brand/patches/05-channel-keys-ipc.patch
diff --git a/packages/desktop/src/main/ipc-handlers/channel-keys.ts b/packages/desktop/src/main/ipc-handlers/channel-keys.ts
new file mode 100644
index 0000000000..9d9b6ccdda
--- /dev/null
+++ b/packages/desktop/src/main/ipc-handlers/channel-keys.ts
@@ -0,0 +1,68 @@
+// [cx] US-009: 本地 key 管理的 IPC handler —— 把 04 的主进程数据层（store-channel-keys）
+// 经 RPC 暴露给 renderer，支撑账户面板的「增删改 key + 手动切换激活 key」。
+//
+// [cx] 上游 v2 重构：v1 这些是 main/ipc.ts 里的 ipcMain.handle("channel-keys-*")。v2 把 IPC
+// 换成 Effect RpcServer，handler 按域拆进 main/ipc-handlers/*，故独立成本文件（与上游的
+// storage.ts / files.ts 等并列）。对上游 ipc.ts 的侵入只剩注册 handler layer 一行。
+//
+// 为什么不复用通用 storage 通道：那边（DesktopStorage）是 renderer 自己的 KV 命名空间，
+// 主进程不读；而 channelKeys 必须由主进程同步读取（起内核前构造 config，见 channel-config.ts），
+// 两侧对同一份对象态读写，故为 key 管理开专用通道、写入统一走 04 的数据层。
+//
+// 安全底线：本文件对 key 管理 handler 一律不打印任何入参（尤其 sk- 明文），仅透传给数据层。
+
+import { Effect } from "effect"
+import { ChannelKeysRpcs } from "../../shared/ipc-rpc/channel-keys"
+// [cx] 内置渠道热重载：增删 key 后重写 OPENCODE_CONFIG 文件，内核监听到变更即重建 provider
+// ——不重启进程（在已注册 key 之间切换更是纯前端桥接、零打断，见 07 的 provider-switch-bridge）。
+import { refreshKeyModelsAndReload, reloadChannelConfig } from "../channel-config"
+import {
+  addChannelKey,
+  readChannelKeysState,
+  removeChannelKey,
+  setActiveChannelKey,
+  setChannelKeyModels,
+  updateChannelKeyLabel,
+} from "../store-channel-keys"
+
+// 每个写操作都在改完后回最新整份状态，renderer 直接拿它刷新 UI（省掉一次额外的 list 往返）。
+const state = () => readChannelKeysState()
+
+// 本组 handler 不依赖任何服务（数据层是同步的纯模块），故用 Effect.sync 而非上游同级那种
+// `Effect.gen` + `yield* Service`——没有依赖可取，空生成器反而更难读。
+export const channelKeysHandlers = ChannelKeysRpcs.toLayer(
+  Effect.sync(() =>
+    ChannelKeysRpcs.of({
+      ChannelKeysList: () => Effect.sync(state),
+      ChannelKeysAdd: ({ label, key, baseURL }) =>
+        Effect.sync(() => {
+          addChannelKey({ label, key, baseURL })
+          return state()
+        }),
+      ChannelKeysRemove: ({ id }) =>
+        Effect.sync(() => {
+          removeChannelKey(id)
+          return state()
+        }),
+      ChannelKeysUpdateLabel: ({ id, label }) =>
+        Effect.sync(() => {
+          updateChannelKeyLabel(id, label)
+          return state()
+        }),
+      ChannelKeysSetActive: ({ id }) =>
+        Effect.sync(() => {
+          setActiveChannelKey(id)
+          return state()
+        }),
+      ChannelKeysSetModels: ({ id, models }) =>
+        Effect.sync(() => {
+          setChannelKeyModels(id, [...models])
+          return state()
+        }),
+      // 拉 /v1/models 可能慢（10s 超时）或失败，但失败已在 channel-config 内部吞掉（返回空列表、
+      // 不动 models 缓存），本 promise 不会 reject，故无需额外的错误通道。
+      ChannelConfigRefreshKey: ({ id }) => Effect.promise(() => refreshKeyModelsAndReload(id)),
+      ChannelConfigReload: () => Effect.sync(reloadChannelConfig),
+    }),
+  ),
+)
