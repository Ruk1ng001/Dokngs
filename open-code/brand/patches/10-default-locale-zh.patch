# 10-default-locale-zh —— 品牌层可配置的首启默认 locale（US-003）
#
# 默认值来自 brand/brand.json，经 02 补丁在构建期注入 DEFAULT_LOCALE；品牌配置缺失时
# 由构建配置回退为 zh。本补丁仅修改 desktop renderer 入口的无存储兜底。
diff --git a/packages/desktop/src/renderer/startup/locale.ts b/packages/desktop/src/renderer/startup/locale.ts
index 7911162d59..03821574fb 100644
--- a/packages/desktop/src/renderer/startup/locale.ts
+++ b/packages/desktop/src/renderer/startup/locale.ts
@@ -20,7 +20,18 @@ export async function preloadStoredLocale(platform: Platform) {
   const cached = localStorage.getItem(cacheKey)
   const locale = storedLocale(cached ?? (await fresh))
 
-  if (!locale) return
+  // [cx] US-003: 本地无语言存储时使用品牌层构建期注入的默认 locale。
+  // DEFAULT_LOCALE 在品牌配置缺失时由 electron.vite.config.ts 回退为 zh；已存储时不覆盖
+  // （此分支只在 store 与其 localStorage 副本都没有 language 时命中，即首启）。
+  // 返回值即 desktop-app.tsx 传给 AppBaseProviders 的 locale，优先级高于 language.tsx 的
+  // readStoredLocale() / detectLocale()——与 v1 在 DesktopRoot.loadLocale 内注入时一致。
+  if (!locale) {
+    const fallbackLocale = normalizeLocale(import.meta.env.DEFAULT_LOCALE)
+
+    if (fallbackLocale !== "en") await loadLocaleDict(fallbackLocale)
+
+    return fallbackLocale
+  }
 
   if (locale !== "en") await loadLocaleDict(locale)
 
