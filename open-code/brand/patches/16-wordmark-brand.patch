+import { createUniqueId } from "solid-js"
+import type { NewSessionWordmark } from "./wordmark"
+import "./wordmark.css"
+
+export function DokngWordmark(props: Parameters<typeof NewSessionWordmark>[0]) {
+  return (
+    <div
+      data-component="new-session-wordmark"
+      aria-hidden="true"
+      class="pointer-events-none mx-auto w-full max-w-[720px] text-v2-background-bg-inverse"
+    >
+      <div ref={props.ref} data-slot="wordmark-box" class="relative mx-auto w-4/5">
+        <WordmarkBrand class="block aspect-[720/129] w-full opacity-[0.16]" />
+        <WordmarkBrand class="wordmark-shimmer absolute inset-0 aspect-[720/129] w-full" />
+      </div>
+    </div>
+  )
+}
+
+// [dokng] Preserve the branded pixel wordmark inside the v2 reveal and shimmer layers.
