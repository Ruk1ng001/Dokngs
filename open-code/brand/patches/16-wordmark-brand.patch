+    <svg
+      xmlns="http://www.w3.org/2000/svg"
+      viewBox="0 0 1024 200"
+      fill="none"
+      classList={{ [props.class ?? ""]: !!props.class }}
+    >
+      <g opacity="0.6">
+        <g mask={`url(#${mask})`} fill="currentColor" shape-rendering="crispEdges">
+          {/* ============ D ============ x=80 */}
+          <g transform="translate(80,44)">
+            <rect x="0" y="0" width="56" height="24" />
+            <rect x="0" y="0" width="24" height="112" />
+            <rect x="0" y="88" width="56" height="24" />
+            <rect x="48" y="16" width="16" height="16" />
+            <rect x="56" y="24" width="16" height="64" />
+            <rect x="48" y="80" width="16" height="16" />
+          </g>
+          {/* ============ O ============ x=232 */}
+          <g transform="translate(232,44)">
+            <rect x="16" y="0" width="40" height="24" />
+            <rect x="16" y="88" width="40" height="24" />
+            <rect x="0" y="16" width="24" height="80" />
+            <rect x="48" y="16" width="24" height="80" />
+            <rect x="8" y="8" width="8" height="8" />
+            <rect x="56" y="8" width="8" height="8" />
+            <rect x="8" y="96" width="8" height="8" />
+            <rect x="56" y="96" width="8" height="8" />
+          </g>
+          {/* ============ K ============ x=384 */}
+          <g transform="translate(384,44)">
+            <rect x="0" y="0" width="24" height="112" />
+            <rect x="48" y="0" width="24" height="24" />
+            <rect x="32" y="16" width="24" height="24" />
+            <rect x="16" y="32" width="24" height="24" />
+            <rect x="16" y="48" width="24" height="20" />
+            <rect x="32" y="64" width="24" height="24" />
+            <rect x="48" y="80" width="24" height="32" />
+          </g>
+          {/* ============ N ============ x=536 */}
+          <g transform="translate(536,44)">
+            <rect x="0" y="0" width="24" height="112" />
+            <rect x="48" y="0" width="24" height="112" />
+            <rect x="16" y="16" width="24" height="32" />
+            <rect x="24" y="40" width="24" height="32" />
+            <rect x="32" y="64" width="24" height="32" />
+          </g>
+          {/* ============ G ============ x=688 */}
+          <g transform="translate(688,44)">
+            <rect x="16" y="0" width="56" height="24" />
+            <rect x="0" y="16" width="24" height="80" />
+            <rect x="16" y="88" width="56" height="24" />
