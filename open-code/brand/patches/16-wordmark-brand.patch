+        <linearGradient id={maskGradient} x1="512" y1="104" x2="512" y2="156" gradientUnits="userSpaceOnUse">
+          <stop stop-color="white" stop-opacity="0.7" />
+          <stop offset="1" stop-color="white" stop-opacity="0" />
