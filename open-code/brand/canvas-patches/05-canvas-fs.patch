+// [dokng] 宿主磁盘桥：画布 ↔ opencode 主进程的文件读写通道。
+//
+// 为什么需要这一层：画布跑在 opencode 桌面壳的 <iframe>（oc://renderer/canvas/）里，
+// 而 electron preload 只注入 BrowserWindow 主 frame（未开 nodeIntegrationInSubFrames），
+// 所以画布侧**没有 window.api**，不能直接 invoke IPC。链路必须是：
+//   画布 → postMessage → 宿主 canvas-embed.tsx → window.api → IPC → 主进程 store-canvas-files.ts
+//
+// 落盘替代了原先的 IndexedDB：
+//   1. IndexedDB 未申请 navigator.storage.persist()，属 best-effort 存储，可被浏览器回收；
+//   2. 节点里存的是 URL.createObjectURL() 的 blob: URL，会话级、重启即失效；
+//   3. 画布 JSON 的 persist 有 debounce 而主进程走 app.exit(0) 硬退出，pending 写会丢。
+// 改为磁盘后，字节与元数据都在 userData 下的固定路径，重启即在。
+//
+// standalone web（window.parent === window）下桥不可用：所有方法返回"未落盘"语义
+// （false / null / 空数组），调用方据此回退到原 IndexedDB 路径，故本模块在纯 web 下无副作用。
+
+// 与宿主 canvas-embed.tsx 的常量一一对应，改一处必须同步改另一处。
+const HOST_ORIGIN = "oc://renderer";
+const FS_REQUEST = "dokng:canvas-fs-request";
+const FS_RESPONSE = "dokng:canvas-fs-response";
+
+// 单次请求超时：写大视频经 base64 过 IPC 可能偏慢，给足 60s；超时按失败处理并回退。
+const REQUEST_TIMEOUT_MS = 60_000;
+
+// 宿主协议分支前缀：oc://renderer/__canvas-file/<sanitized key>.<ext>
+// 复用宿主 origin，故 <img src> / <video src> 可直接引用磁盘文件——
+// 无需 blob: URL、无跨源与 CSP 问题，且走浏览器原生缓存。
+const FILE_URL_PREFIX = "oc://renderer/__canvas-file/";
+
+export const IS_EMBEDDED = typeof window !== "undefined" && window.parent !== window;
+
+type Pending = { resolve: (value: unknown) => void; reject: (error: Error) => void; timer: number };
+
+const pending = new Map<string, Pending>();
+let listenerBound = false;
+let seq = 0;
+
+function bindListener() {
+    if (listenerBound || typeof window === "undefined") return;
+    listenerBound = true;
+    window.addEventListener("message", (event: MessageEvent) => {
+        // 严格校验来源：只认宿主 origin 且确实来自父窗口的回帖。
+        if (event.origin !== HOST_ORIGIN || event.source !== window.parent) return;
+        const data = event.data as { type?: unknown; id?: unknown; ok?: unknown; result?: unknown } | null;
+        if (!data || typeof data !== "object" || data.type !== FS_RESPONSE) return;
+        const id = typeof data.id === "string" ? data.id : null;
+        if (!id) return;
+        const entry = pending.get(id);
+        if (!entry) return;
+        pending.delete(id);
+        window.clearTimeout(entry.timer);
+        if (data.ok === true) entry.resolve(data.result);
+        else entry.reject(new Error("宿主落盘失败"));
+    });
+}
+
+// 发一次请求并等回帖。宿主不可用 / 超时 / 宿主报错都 reject，由各 call* 包装成回退语义。
+function request(op: string, args: unknown[]): Promise<unknown> {
+    if (!IS_EMBEDDED) return Promise.reject(new Error("未嵌入宿主"));
+    bindListener();
+    const parent = window.parent;
+    const id = `fs-${Date.now().toString(36)}-${(seq += 1).toString(36)}`;
+    return new Promise<unknown>((resolve, reject) => {
+        const timer = window.setTimeout(() => {
+            pending.delete(id);
+            reject(new Error("宿主落盘超时"));
+        }, REQUEST_TIMEOUT_MS);
+        pending.set(id, { resolve, reject, timer });
+        parent.postMessage({ type: FS_REQUEST, id, op, args }, HOST_ORIGIN);
+    });
+}
+
+// 二进制经 IPC 用 base64 传（与既有 store-* 的字符串约定一致，且避开 sandbox 下可转移对象的差异）。
+// 分块转换：大文件下 String.fromCharCode(...bytes) 会因参数过多爆栈。
+function bytesToBase64(bytes: Uint8Array) {
+    const CHUNK = 0x8000;
+    let binary = "";
+    for (let i = 0; i < bytes.length; i += CHUNK) {
+        binary += String.fromCharCode(...bytes.subarray(i, i + CHUNK));
+    }
+    return btoa(binary);
+}
+
+function base64ToBytes(base64: string) {
+    const binary = atob(base64);
+    const bytes = new Uint8Array(binary.length);
+    for (let i = 0; i < binary.length; i += 1) bytes[i] = binary.charCodeAt(i);
+    return bytes;
+}
+
+// 写入一个媒体 Blob。成功返回 true；未嵌入宿主 / 失败返回 false（调用方回退 IndexedDB）。
+export async function writeHostFile(storageKey: string, blob: Blob) {
+    if (!IS_EMBEDDED) return false;
+    try {
+        const bytes = new Uint8Array(await blob.arrayBuffer());
+        const ok = await request("fileWrite", [storageKey, bytesToBase64(bytes), blob.type || ""]);
+        // 缓存维护放在这里而非交给调用方：漏调会让刚落盘的图在 resolve 时判定为"未落盘"而回退。
+        if (ok === true) noteHostFile(storageKey, true);
+        return ok === true;
+    } catch {
+        return false;
+    }
+}
+
+// 读回媒体字节。不存在 / 失败返回 null。
+// 注意：正常渲染不走这里——渲染直接用 hostFileUrl() 让浏览器加载磁盘文件。
+// 本函数只服务于确实需要字节本身的场景（导出、WebDAV 同步、图生图取原图）。
+export async function readHostFile(storageKey: string, mimeType = "application/octet-stream") {
+    if (!IS_EMBEDDED) return null;
+    try {
+        const base64 = await request("fileRead", [storageKey]);
+        if (typeof base64 !== "string" || !base64) return null;
+        return new Blob([base64ToBytes(base64)], { type: mimeType });
+    } catch {
+        return null;
+    }
+}
+
+export async function deleteHostFiles(storageKeys: string[]) {
+    if (!IS_EMBEDDED || storageKeys.length === 0) return 0;
+    try {
+        const removed = await request("fileDelete", [storageKeys]);
+        // 无论主进程实际删了几个，这些 key 都不该再被当作"已落盘"。
+        storageKeys.forEach((key) => noteHostFile(key, false));
+        return typeof removed === "number" ? removed : 0;
+    } catch {
+        return 0;
+    }
+}
+
+export async function listHostFiles() {
+    if (!IS_EMBEDDED) return [];
+    try {
+        const keys = await request("fileList", []);
+        return Array.isArray(keys) ? keys.filter((k): k is string => typeof k === "string") : [];
+    } catch {
+        return [];
+    }
+}
+
+export async function readHostState() {
+    if (!IS_EMBEDDED) return null;
+    try {
+        const json = await request("stateRead", []);
+        return typeof json === "string" ? json : null;
+    } catch {
+        return null;
+    }
+}
+
+export async function writeHostState(json: string) {
+    if (!IS_EMBEDDED) return false;
+    try {
+        const ok = await request("stateWrite", [json]);
+        return ok === true;
+    } catch {
+        return false;
+    }
+}
+
+// storageKey → 可直接放进 src 的 URL。":" 换 "__" 与主进程 sanitizeKey 一致；
+// 不带扩展名，宿主协议分支会扫目录定扩展名（进而定 Content-Type）。
+export function hostFileUrl(storageKey: string) {
+    return `${FILE_URL_PREFIX}${encodeURIComponent(storageKey.replace(":", "__"))}`;
+}
+
+// —— 磁盘 key 缓存 ——
+// resolveImageUrl / resolveMediaUrl 会被大量节点并发调用，每次都问一遍宿主会放大 postMessage
+// 往返。这里缓存一次目录列表，写入/删除时增量维护。image-storage 与 file-storage 共用同一份
+// （磁盘目录本身是共用的，各自维护会出现一方的写入在另一方缓存里缺失）。
+let keysCache: Set<string> | null = null;
+let keysLoading: Promise<Set<string>> | null = null;
+
+async function hostFileKeys() {
+    if (keysCache) return keysCache;
+    if (!keysLoading) {
+        keysLoading = listHostFiles()
+            .then((keys) => {
+                keysCache = new Set(keys);
+                return keysCache;
+            })
+            .finally(() => {
+                keysLoading = null;
+            });
+    }
+    return keysLoading;
+}
+
+// 该 key 是否已落盘。未嵌入宿主时恒为 false（调用方回退 IndexedDB）。
+export async function hasHostFile(storageKey: string) {
+    if (!IS_EMBEDDED) return false;
+    return (await hostFileKeys()).has(storageKey);
+}
+
+// 写入/删除后同步缓存，避免刚落盘的 key 在缓存里缺失而回退到 fallback。
+export function noteHostFile(storageKey: string, exists: boolean) {
+    if (!keysCache) return;
+    if (exists) keysCache.add(storageKey);
+    else keysCache.delete(storageKey);
+}
+
+// 磁盘上现存的全部 key（供孤儿清理）。未嵌入宿主返回空集合。
+export async function hostFileKeySet() {
+    if (!IS_EMBEDDED) return new Set<string>();
+    return hostFileKeys();
+}
