+/**
+ * Route media (image/video) generation through the `media.` subdomain so those long-running
+ * requests bypass the CDN's request-timeout limit. Text/audio keep the channel's original host.
+ * The backend accepts both the original host and the media subdomain, so this is a pure host rewrite.
+ * Idempotent, and left untouched for localhost / IP hosts where a media subdomain makes no sense.
+ */
+export function toMediaBaseUrl(baseUrl: string) {
+    const trimmed = baseUrl.trim();
+    try {
+        const url = new URL(trimmed);
+        const host = url.hostname;
+        if (host === "localhost" || /^[\d.]+$/.test(host) || host.startsWith("media.")) return trimmed;
+        url.hostname = `media.${host}`;
+        return url.toString().replace(/\/+$/, "");
+    } catch {
+        return trimmed;
+    }
+}
+
