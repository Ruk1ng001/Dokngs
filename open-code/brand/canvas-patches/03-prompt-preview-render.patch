@@ -4,8 +4,34 @@ import { useTranslation } from "react-i18next";
 
 import { formatPromptDate, type Prompt } from "@/services/api/prompts";
 
+// [dokng] preview 字段可能含「markdown 图片 + 说明文字」（v0.10.0 起来自预编译 registry JSON
+// 的 preview 字段；v0.9.0 时代由 prompts.ts 的 markdownPreview 拼出）。上游用 <pre> 原样直出，
+// preview 含 ![](url) 时退化成一串裸文本、图片不渲染。这里做零依赖轻量解析：把 markdown 图片
+// 语法 ![alt](url) 抽成真正的 <img>，其余非空行按说明文字保留（纯文本 preview 行为与上游等价）。
+// 不引 react-markdown，只认这两种片段。
+type PreviewSegment = { type: "image"; url: string; alt: string } | { type: "text"; text: string };
+
+function parsePreview(preview: string): PreviewSegment[] {
+    const segments: PreviewSegment[] = [];
+    const imagePattern = /!\[([^\]]*)]\(([^)\s]+)[^)]*\)/g;
+    let lastIndex = 0;
+    let match: RegExpExecArray | null;
+    const pushText = (raw: string) => {
+        const text = raw.trim();
+        if (text) segments.push({ type: "text", text });
+    };
+    while ((match = imagePattern.exec(preview))) {
+        pushText(preview.slice(lastIndex, match.index));
+        segments.push({ type: "image", alt: match[1] || "", url: match[2] });
+        lastIndex = imagePattern.lastIndex;
+    }
+    pushText(preview.slice(lastIndex));
+    return segments;
+}
+
 export function PromptDetailDialog({ prompt, onClose, onCopy, onSaveAsset }: { prompt: Prompt | null; onClose: () => void; onCopy: (prompt: string) => void; onSaveAsset?: (prompt: Prompt) => void }) {
     const { i18n, t } = useTranslation();
+    const previewSegments = prompt?.preview ? parsePreview(prompt.preview) : [];
 
     return (
         <Modal title={prompt?.title} open={Boolean(prompt)} onCancel={onClose} footer={null} width={720} centered styles={{ body: { height: "calc(85vh - 55px)", overflow: "hidden" } }}>
