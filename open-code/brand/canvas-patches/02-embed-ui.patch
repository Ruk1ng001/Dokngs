+// [dokng] GitHub raw 域（raw.githubusercontent.com）国内基本不可达。上游 v0.10.0 起提示词改为
+// 拉取预编译 JSON registry（内置六源的 url 都在 raw 域），图片链接也来自 registry JSON。
+// 与 v0.9.0 时代对 prompts.ts 的适配同义迁移到本文件（新的唯一网络入口）：
+//   1. toCdn()：把 raw.githubusercontent.com/{owner}/{repo}/{ref}/... 重写为
+//      cdn.jsdelivr.net/gh/{owner}/{repo}@{ref}/...（jsDelivr 的 GitHub 镜像，国内可达），
+//      应用于 fetchSource 的 source.url（覆盖内置六源与用户自定义 raw 链接；非 raw 链接原样）。
+//   2. proxyImage()：对「非 GitHub raw 的绝对图片链接」统一套图片代理（默认公共 weserv，
+//      可换自建 Cloudflare Worker 反代，如 https://img.dokng.com/?url=；设空串整体关闭），
+//      raw 链接走 jsDelivr；应用于 normalizeItems 产出的 coverUrl / referenceImageUrls。
+//      sourceUrl 是「查看原文」网页链接，不做改写。
+function toCdn(url: string) {
+    return url.replace(/^https:\/\/raw\.githubusercontent\.com\/([^/]+)\/([^/]+)\/([^/]+)(\/.*)?$/, "https://cdn.jsdelivr.net/gh/$1/$2@$3$4");
+}
+
+const IMAGE_PROXY = "https://images.weserv.nl/?url=";
+
+function proxyImage(url: string) {
+    if (!url) return url;
+    if (/^https:\/\/raw\.githubusercontent\.com\//i.test(url)) return toCdn(url);
+    if (!IMAGE_PROXY) return url;
+    // 已经是代理 / jsDelivr 链接的不再二次包裹。
+    if (url.startsWith(IMAGE_PROXY) || /^https:\/\/cdn\.jsdelivr\.net\//i.test(url)) return url;
+    return `${IMAGE_PROXY}${encodeURIComponent(url.replace(/^https?:\/\//i, ""))}`;
+}
