# 画布补丁分组清单：仅用于文档与自动一致性校验；执行顺序仍以 canvas-patches/*.patch 文件名为准。
# 每段 section 名必须与同名 .patch 文件一致。

# iframe 宿主配置注入与路由/持久化适配：
# - client-root-init.tsx 接收宿主 dokng:canvas-config、发送 ready 握手；
# - router.tsx 改用 hash router，适配 oc://renderer/canvas/index.html；
# - use-config-store.ts 嵌入态持久化时剥离 apiKey。
[01-embed-inject]
web/src/components/layout/client-root-init.tsx
web/src/router.tsx
web/src/stores/use-config-store.ts

# 嵌入态 UI 与提示词源国内可达适配：
# - 精简顶栏：只隐藏主题切换 / 版本 / GitHub 三个入口（嵌入桌面壳内主题跟随宿主、版本与仓库标识
#   对终端用户无意义），文档 / 配置 / 节点插件 / 语言切换 / 快捷键一律保留。语言切换是上游
#   v0.14.0 新增的入口，属于有意保留项，rebase 解冲突时勿连带删除；
# - 首页只保留 hero：移除 showcase 区块及其 fetchPrompts 拉取，hero 改 flex 伸缩铺满视口；
# - 提示词源国内可达（上游 v0.10.0 起提示词重构为预编译 JSON registry，原 prompts.ts 的
#   markdown 解析 hook 点消失，适配同义迁移到新的唯一网络入口 prompt-source-runtime.ts）：
#   registry JSON 拉取经 toCdn 走 jsDelivr 镜像（覆盖内置六源与自定义 raw 链接）；
#   coverUrl / referenceImageUrls 图片经 proxyImage（raw→jsDelivr，其余外链→weserv 图片代理，
#   常量可换自建反代或置空关闭）；sourceUrl（查看原文网页链接）不改写。
[02-embed-ui]
web/src/components/layout/user-status-actions.tsx
web/src/pages/home/index.tsx
web/src/services/api/prompt-source-runtime.ts

