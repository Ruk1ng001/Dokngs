+import {
+  AccountEntryButton,
+  CcsAccountMount,
+} from "@/components/account/CcsAccountMount";
 import { McpIcon } from "@/components/BrandIcons";
 import { Button } from "@/components/ui/button";
 import { SessionManagerPage } from "@/components/sessions/SessionManagerPage";
@@ -1342,6 +1347,8 @@ function App() {
                 >
                   <Settings className="w-4 h-4" />
                 </Button>
+                {/* [ccs] 账户面板入口按钮 */}
+                <AccountEntryButton />
                 <UpdateBadge
                   onClick={() => {
                     setSettingsDefaultTab("about");
@@ -1823,6 +1830,8 @@ function App() {
 
       <DeepLinkImportDialog />
       <FirstRunNoticeDialog />
+      {/* [ccs] 账户面板挂载（Dialog + 首启自动弹出 + 托盘 "ccs-open-account" 监听） */}
+      <CcsAccountMount contentTopOffset={contentTopOffset} />
     </div>
   );
 }
